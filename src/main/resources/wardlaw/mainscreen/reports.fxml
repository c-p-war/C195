<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="589.0" prefWidth="877.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="wardlaw.mainscreen.reportsController">
    <children>
        <Label fx:id="labelReports" layoutX="14.0" layoutY="14.0" text="Reports" />
        <Label fx:id="labelMonthType" layoutX="56.0" layoutY="292.0" text="Appointments by Month and Type" />
        <TableView fx:id="tableMonth" layoutX="35.0" layoutY="309.0" prefHeight="200.0" prefWidth="226.0">
            <columns>
                <TableColumn fx:id="colMonth" prefWidth="75.0" text="Month" />
                <TableColumn fx:id="colMonthType" prefWidth="75.0" text="Type" />
            <TableColumn fx:id="colMonthCount" prefWidth="75.0" text="Count" />
            </columns>
        </TableView>
        <Label fx:id="labelSched" layoutX="385.0" layoutY="31.0" text="Contact Schedule" />
        <TableView fx:id="tableSched" layoutX="35.0" layoutY="83.0" prefHeight="200.0" prefWidth="797.0">
            <columns>
                <TableColumn fx:id="colSchedApptId" prefWidth="57.0" text="Appt. Id" />
                <TableColumn fx:id="colSchedTitle" prefWidth="118.0" text="Title" />
                <TableColumn fx:id="colSchedType" prefWidth="74.0" text="Type" />
                <TableColumn fx:id="colSchedDesc" prefWidth="189.0" text="Description" />
                <TableColumn fx:id="colSchedStart" minWidth="0.0" prefWidth="119.0" text="Start" />
                <TableColumn fx:id="colSchedEnd" prefWidth="107.0" text="End" />
                <TableColumn fx:id="colSchedCustId" prefWidth="50.0" text="Cust. Id" />
            </columns>
        </TableView>
        <Label fx:id="labelCountry" layoutX="652.0" layoutY="292.0" text="Customers by Country (custom)" />
        <TableView fx:id="tableCountry" layoutX="647.0" layoutY="309.0" prefHeight="200.0" prefWidth="185.0">
            <columns>
                <TableColumn fx:id="colCountry" prefWidth="88.0" text="Country" />
                <TableColumn fx:id="colCountryCount" prefWidth="96.0" text="Count" />
            </columns>
        </TableView>
        <Button fx:id="btnCancel" layoutX="14.0" layoutY="546.0" mnemonicParsing="false" onAction="#cancel" text="Cancel" />
      <ComboBox fx:id="comboContact" layoutX="359.0" layoutY="48.0" onAction="#selectContact" prefWidth="150.0" />
    </children>
</AnchorPane>
